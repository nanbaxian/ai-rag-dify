#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(dirname "$(realpath "$0")")"
ROOT="$(dirname "$SCRIPT_DIR")"

cd "$ROOT"

echo "Updating repository at $ROOT"

if [[ -n "$(git status --porcelain --untracked-files=no)" ]]; then
  echo "Local changes detected, stashing them before pull..."
  git stash push -m "deploy-server auto stash $(date '+%Y-%m-%d %H:%M:%S')" >/dev/null
fi

git pull --ff-only

echo "Syncing backend dependencies..."
cd "$ROOT/api"
uv sync --group dev

echo "Syncing frontend dependencies..."
cd "$ROOT"
pnpm install

echo "Building frontend..."
cd "$ROOT/web"
node ./node_modules/next/dist/bin/next build

cd "$ROOT"
echo "Restarting services..."
./dev/start-api --stop || true
./dev/start-worker --stop || true
./dev/start-web --stop || true

./dev/start-api
./dev/start-worker
./dev/start-web

echo "Deployment finished."
